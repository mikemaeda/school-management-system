# Database configuration
DB_DRIVER=org.sqlite.JDBC
DB_URL=jdbc:sqlite:school_management.db
DB_USER=
DB_PASSWORD=

# Email configuration
# Gmail users should create an app password instead of using their normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
